{
  "name": "chord-cli",
  "version": "0.3.1",
  "description": "Run several coding agents in one git project, each in its own worktree, with shared file claims and messaging",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "codex",
    "coding-agents",
    "git-worktree",
    "multi-agent",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cedr1cSun/chord-cli.git"
  },
  "homepage": "https://github.com/Cedr1cSun/chord-cli#readme",
  "bugs": {
    "url": "https://github.com/Cedr1cSun/chord-cli/issues"
  },
  "type": "module",
  "bin": {
    "chord": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9"
  }
}
